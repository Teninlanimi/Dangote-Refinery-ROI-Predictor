# Copy to .env and fill in.  NEVER commit .env.

# --- Database (docker-compose builds DATABASE_URL from these) ---
POSTGRES_USER=roi
# letters and digits only (it goes inside a URL). Make one with:  openssl rand -hex 16
POSTGRES_PASSWORD=change-me
POSTGRES_DB=roi

# --- Data sources ---
# Free key (covers Brent, petrol and diesel): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# --- Pipeline ---
# Hours (UTC) to pull fresh data
SCHEDULE_HOURS_UTC=6,18
# Optional: lets you trigger a run with POST /admin/ingest (header X-Ingest-Token). Leave empty to disable.
INGEST_TOKEN=

# --- Web ---
# 1 when running behind a proxy that sets X-Forwarded-For (docker-compose sets this for you)
# TRUST_PROXY=1
# ":80" serves plain HTTP on the server's IP. Put a domain here (e.g. roi.example.com
# or 3.85.12.34.sslip.io) and Caddy fetches a free HTTPS certificate automatically.
DOMAIN=:80
